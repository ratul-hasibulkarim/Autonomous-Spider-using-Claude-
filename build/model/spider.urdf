    <type>transmission_interface/SimpleTransmission</type>
    <joint name="sensor_pan_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="sensor_pan_motor"><mechanicalReduction>1</mechanicalReduction><!-- driver: electronics/gdrv0 --></actuator>
  </transmission>
  <transmission name="sensor_tilt_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="sensor_tilt_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="sensor_tilt_motor"><mechanicalReduction>1</mechanicalReduction><!-- driver: electronics/gdrv1 --></actuator>
  </transmission>
</robot>
